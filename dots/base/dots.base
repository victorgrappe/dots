filters:
  and:
    - file.folder.endsWith("dot")
formulas:
  class__1: if(note.class, note.class, note.type)
  class__2: formula.class__1.asFile().properties.class
  class__3: formula.class__2.asFile().properties.class
  class__4: formula.class__3.asFile().properties.class
  class__5: formula.class__4.asFile().properties.class
  class__6: formula.class__5.asFile().properties.class
  class__7: formula.class__6.asFile().properties.class
  class__8: formula.class__7.asFile().properties.class
  class__ancestors: "[formula.class__1, formula.class__2, formula.class__3, formula.class__4, formula.class__5, formula.class__6, formula.class__7, formula.class__8].filter(value).map(value.asFile().name)"
  class__dir: '[formula.class__8, formula.class__7, formula.class__6, formula.class__5, formula.class__4, formula.class__3, formula.class__2, formula.class__1].filter(value).map(value.asFile().name).join(".")'
  class__path: if(formula.class__dir, formula.class__dir + "." + file.name, file.name)
  path: if(formula.class__dir, formula.class__dir + if(note.class, ".", "--") + file.name, file.name)
  wikipedia__url: if(note.wikidata__cd, link(wikipediaUrl(note.wikidata__cd), "Wiki EN"))
  wikipedia__url__button: if(formula.wikipedia__url, html("<a href=" + formula.wikipedia__url.toString() + " class=dots-wiki-button>Wikipedia ↗</a>"))
  in__name: '[in.asFile().name,class.asFile().name,out.asFile().name].join("--")'
  sandbox: |
    [in.title().toString()].join("___")
views:
  - type: table
    name: Dot
    order:
      - file.name
      - class
      - type
      - file.path
      - formula.class__path
      - formula.path
      - wikidata__cd
      - formula.wikipedia__url
      - formula.wikipedia__url__button
      - uri
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
      - property: file.mtime
        direction: DESC
      - property: class
        direction: DESC
    columnSize:
      file.name: 355
      note.class: 172
      formula.class__path: 312
      formula.wikipedia__url__button: 104
  - type: table
    name: class__all
    order:
      - file.name
      - class
      - formula.class__ancestors
      - formula.class__dir
      - formula.class__path
      - formula.class__8
      - formula.class__7
      - formula.class__6
      - formula.class__5
      - formula.class__4
      - formula.class__3
      - formula.class__2
      - formula.class__1
    sort:
      - property: formula.class__ancestors
        direction: ASC
      - property: formula.class__dir
        direction: ASC
    columnSize:
      file.name: 309
      note.class: 99
      formula.class__ancestors: 285
      formula.class__dir: 266
      formula.class__path: 297
      formula.class__8: 96
  - type: table
    name: Dot Test
    order:
      - file.name
      - class
      - type
      - file.path
      - formula.class__path
      - formula.path
      - wikidata__cd
      - formula.wikipedia__url
      - formula.wikipedia__url__button
      - uri
      - file.mtime
      - file.folder
    sort:
      - property: file.mtime
        direction: DESC
      - property: class
        direction: DESC
    columnSize:
      file.name: 174
      note.class: 98
      formula.class__path: 312
  - type: table
    name: Dot.subclass
    filters:
      and:
        - note.class.isEmpty() == false
        - formula.class__path.contains(this.file.name)
    order:
      - formula.class__path
      - file.name
      - name__fr
      - description
      - uri
      - wikidata__cd
      - formula.wikipedia__url
      - file.mtime
    sort:
      - property: formula.class__path
        direction: ASC
    columnSize:
      formula.class__path: 610
      file.name: 441
      note.name__fr: 411
      note.description: 702
      note.uri: 427
  - type: table
    name: Aliment
    filters:
      and:
        - formula.class__path.contains("Aliment")
        - "!class.isEmpty()"
    order:
      - formula.class__path
      - file.name
      - name__fr
      - wikidata__cd
      - description
    sort:
      - property: formula.class__path
        direction: ASC
    columnSize:
      formula.class__path: 509
      file.name: 295
      note.name__fr: 211
      note.description: 932
  - type: table
    name: Country
    filters:
      and:
        - type == link("Country")
    order:
      - file.name
      - country_a2
      - country_a3
      - country_n3
  - type: table
    name: Financial Instrument
    filters:
      and:
        - formula.class__ancestors.contains("Financial Instrument")
    order:
      - formula.class__path
      - file.name
      - name__fr
      - description
      - formula.wikipedia__url__button
      - fibo__uri
    sort:
      - property: formula.class__path
        direction: ASC
    columnSize:
      formula.class__path: 483
      file.name: 168
      note.name__fr: 192
      note.description: 932
      formula.wikipedia__url__button: 104
      note.fibo__uri: 114
  - type: table
    name: Recipe
  - type: table
    name: Relation
    filters:
      and:
        - class == link("Relation")
    order:
      - file.name
      - class__order
      - description
      - example
    sort:
      - property: class__order
        direction: ASC
    columnSize:
      file.name: 171
    rowHeight: medium
  - type: table
    name: Software
    filters:
      and:
        - formula.class__path.contains("Software")
    order:
      - formula.class__path
      - class
      - type
      - file.name
      - description
      - wikidata__cd
      - uri
    sort:
      - property: formula.class__path
        direction: ASC
    columnSize:
      formula.class__path: 293
      note.class: 178
      file.name: 189
      note.description: 657
  - type: table
    name: class
    filters:
      and:
        - "!class.isEmpty()"
    order:
      - formula.class__path
      - class
      - file.name
    sort:
      - property: formula.class__path
        direction: ASC
    columnSize:
      formula.class__path: 525
      note.class: 185
      file.name: 309
  - type: table
    name: in.class_
    filters:
      and:
        - class == link("in")
        - or:
            - this.file.ext == "base"
            - in.asFile().path == this.file.path
    order:
      - file.name
      - in
      - class
      - out
      - formula.in__name
    sort:
      - property: formula.in__name
        direction: DESC
      - property: out
        direction: ASC
      - property: in
        direction: ASC
    columnSize:
      file.name: 307
      note.in: 270
      note.class: 107
      note.out: 152
